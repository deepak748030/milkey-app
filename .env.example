# Shared backend API URL for the Expo app (APK + Expo Web) and the Vite admin web.
# Include /api (the Expo app also appends it automatically if omitted).
EXPO_PUBLIC_API_URL=https://milkey-app.onrender.com/api

# Optional: override the API URL for the Vite admin web only.
# VITE_API_URL=https://your-backend.example.com/api

# Optional local Vite proxy target (backend origin, without /api).
# Used only when the web app is using the same-origin /api fallback.
# VITE_API_PROXY_TARGET=http://localhost:5000
