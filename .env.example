# Shared public API base URL for the Expo app (APK + Expo Web) and Vite admin web.
# The app appends /api automatically if it is omitted.
API_URL=https://milkey-app.onrender.com/api

# Optional environment-specific overrides (leave unset to use API_URL).
# EXPO_PUBLIC_API_URL=https://your-backend.example.com/api
# VITE_API_URL=https://your-backend.example.com/api

# Optional local Vite proxy target (backend origin, without /api).
# Used only when no API URL is set and the web app uses the same-origin /api fallback.
# VITE_API_PROXY_TARGET=http://localhost:5000
