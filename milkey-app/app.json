{
  "expo": {
    "name": "Milkey",
    "slug": "milkey",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "milkey",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.milkey.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Milkey needs Bluetooth access to connect to thermal printers for printing receipts.",
        "NSBluetoothPeripheralUsageDescription": "Milkey needs Bluetooth access to connect to thermal printers for printing receipts.",
        "NSLocationWhenInUseUsageDescription": "Milkey needs location access to scan for nearby Bluetooth printers.",
        "NSCameraUsageDescription": "Milkey needs camera access to scan QR codes and take photos.",
        "NSPhotoLibraryUsageDescription": "Milkey needs photo library access to upload images."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFFFFF",
          "sounds": [
            "./assets/sounds/notification.mp3"
          ]
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Milkey needs camera access to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Milkey needs photo library access to upload images.",
          "cameraPermission": "Milkey needs camera access to take photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Milkey needs location access to scan for nearby Bluetooth printers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5105d798-655a-478f-9ff0-062ac18b4e0e"
      }
    }
  }
}