{
  "expo": {
    "name": "Milkey",
    "slug": "milkey",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "milkey",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.milkey.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0d3b1f"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": []
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Milkey needs Bluetooth access to connect to thermal printers for printing receipts.",
        "NSBluetoothPeripheralUsageDescription": "Milkey needs Bluetooth access to connect to thermal printers for printing receipts.",
        "NSLocationWhenInUseUsageDescription": "Milkey needs location access to scan for nearby Bluetooth printers.",
        "NSCameraUsageDescription": "Milkey needs camera access to scan QR codes and take photos.",
        "NSPhotoLibraryUsageDescription": "Milkey needs photo library access to upload images."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://jitpack.io"
            ],
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFFFFF",
          "sounds": [
            "./assets/sounds/notification.mp3"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Milkey needs camera access to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Milkey needs photo library access to upload images.",
          "cameraPermission": "Milkey needs camera access to take photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Milkey needs location access to scan for nearby Bluetooth printers.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withBluetoothScanPermission",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {}
    }
  }
}