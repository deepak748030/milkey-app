{
  "name": "milkey-server",
  "version": "1.0.0",
  "description": "Milkey Dairy Management API Server",
  "main": "index.js",
  "scripts": {
    "build": "echo \"no build needed for server\"",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "backup": "node scripts/backup.js",
    "backup:gzip": "node scripts/backup.js --gzip",
    "backup:dry": "node scripts/backup.js --dry-run",
    "restore": "node scripts/restore.js",
    "restore:dry": "node scripts/restore.js --dry-run",
    "migrate": "node scripts/migrate.js",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "migrate:verify": "node scripts/migrate.js --verify",
    "sync:clone": "node scripts/sync-to-clone.js",
    "sync:clone:dry": "node scripts/sync-to-clone.js --dry-run",
    "sync:clone:verify": "node scripts/sync-to-clone.js --verify",
    "sync:clone:limit": "node scripts/sync-to-clone.js --limit 10"
  },
  "keywords": [
    "dairy",
    "milk",
    "api",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.0",
    "bson": "^6.10.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
